#!/usr/bin/env bash
# PreToolUse hook for Edit/Write/NotebookEdit: keeps agents out of files that are generated,
# or that belong to upstream and would only make the next upstream merge conflict.
#
# deny: the edit is always wrong; the reason says what to do instead.
# ask:  the edit is occasionally right; the user decides.

set -euo pipefail

input="$(cat)"
path="$(jq -r '.tool_input.file_path // .tool_input.notebook_path // empty' <<<"$input")"
[[ -n "$path" ]] || exit 0

root="$(git -C "$(dirname "$path")" rev-parse --show-toplevel 2>/dev/null || echo "${CLAUDE_PROJECT_DIR:-}")"
rel="${path#"$root"/}"

decide() {
	jq -n --arg d "$1" --arg r "$2" \
		'{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: $d, permissionDecisionReason: $r}}'
	exit 0
}

case "$rel" in
internal/api/generated_*.go | ui/v2.5/src/core/generated-graphql.ts)
	decide deny "$rel is generated from graphql/schema/ and overwritten on every build. Change the schema (or ui/v2.5/graphql/ documents) and run make generate." ;;
pkg/models/mocks/*)
	decide deny "$rel is generated by mockery. Change the interface and run make generate-test-mocks." ;;
pkg/stashbox/graphql/*)
	decide deny "$rel is upstream's copy, generated from stashdb.org's live schema. The fork never changes it (docs/codebase/12-upstream-sync.md)." ;;
pkg/sqlite/migrations/*)
	decide deny "pkg/sqlite/migrations/ is upstream's migration stream. Fork migrations go in pkg/sqlite/migrations_fork/ (see its README.md)." ;;
internal/api/loaders/*_gen.go)
	decide ask "$rel is dataloaden output that was hand-fixed after generation (docs/codebase/12-upstream-sync.md). Fork loaders belong in files of their own." ;;
ui/v2.5/src/docs/en/Changelog/*)
	decide ask "$rel is upstream's in-app release changelog. Fork changes are recorded in FORK_CHANGELOG.md (scripts/changelog), not here." ;;
esac
exit 0
