#!/usr/bin/env bash
# Write FORK_CHANGELOG.md: what this fork changed, from its own commits.
#
# Two changelogs live in this repository, and they don't mix:
#
#   FORK_CHANGELOG.md                 this fork's changes: every commit on this branch that
#                                     isn't upstream's, plus each upstream sync. Generated here.
#   ui/v2.5/src/docs/en/Changelog/    upstream stash's release notes, one file per release,
#                                     shown in the app. Upstream writes them; the fork never
#                                     edits them, or every upstream merge would conflict.
#
# Fork commits are the ones not reachable from upstream/develop, written as conventional
# commits (feat(ui): ..., fix(sqlite): ...). Upstream's own subjects ("Fix: ...", "New: ...")
# never match that form, so a stale upstream/develop can't leak them in. Merges from
# upstream become one line each, pointing at upstream's changelog for what they brought.
#
# The file only covers committed work, so it's updated after the commits it describes:
#
#   git commit -m "feat(ui): ..."                  the work
#   scripts/changelog                              regenerate
#   git commit -m "chore(changelog): update FORK_CHANGELOG.md" FORK_CHANGELOG.md
#
# Commits with exactly that last subject are left out, so updating the changelog doesn't
# add an entry of its own. Updating once per batch of work (before a ship, after an upstream
# sync) is enough; it doesn't need a commit per commit.
#
# Usage: scripts/changelog           rewrite FORK_CHANGELOG.md
#        scripts/changelog --check   exit 1 if FORK_CHANGELOG.md is out of date

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

UPSTREAM_REF=upstream/develop
OUT=FORK_CHANGELOG.md
# commits that only regenerate $OUT are left out of it
UPDATE_SUBJECT="chore(changelog): update FORK_CHANGELOG.md"
# section order within a day; anything else sorts last
TYPES=(feat fix tune perf refactor revert docs scripts chore test style build)

die() { echo "changelog: $*" >&2; exit 1; }
info() { echo "==> $*"; }

git rev-parse -q --verify "$UPSTREAM_REF" >/dev/null || die "no $UPSTREAM_REF; run: git fetch upstream"

rank() {
	local i
	for i in "${!TYPES[@]}"; do [[ "${TYPES[$i]}" == "$1" ]] && { echo "$i"; return; }; done
	echo 99
}

# one line per entry: date <tab> rank <tab> markdown
entries() {
	local hash date subject type merged count
	while IFS=$'\t' read -r hash date subject; do
		[[ "$subject" =~ ^([a-z]+)[a-z,\ ]*(\([^\)]*\))?!?:\  ]] || continue
		type="${BASH_REMATCH[1]}"
		[[ "$subject" == "$UPDATE_SUBJECT" ]] && continue # this script's own output
		printf '%s\t%s\t- %s `%s`\n' "$date" "$(rank "$type")" "$subject" "$hash"
	done < <(git log --no-merges --format='%h%x09%ad%x09%s' --date=short "$UPSTREAM_REF..HEAD")

	while IFS=$'\t' read -r hash date subject; do
		git rev-parse -q --verify "$hash^2" >/dev/null || continue
		merged="$(git rev-parse --short=8 "$hash^2")"
		count="$(git rev-list --count "$hash^1..$hash^2")"
		printf '%s\t%s\t- **upstream sync**: merged stashapp/stash `develop` at `%s` (%s upstream commits) `%s`. What they changed is in upstream'"'"'s changelog, not here\n' \
			"$date" -1 "$merged" "$count" "$hash"
	done < <(git log --merges --first-parent --format='%h%x09%ad%x09%s' --date=short "$UPSTREAM_REF..HEAD" |
		grep -F "$UPSTREAM_REF" || true)
}

render() {
	local base base_date
	base="$(git merge-base HEAD "$UPSTREAM_REF")"
	base_date="$(git log -1 --format=%ad --date=short "$base")"
	cat <<EOF
# Fork changelog

What this fork (\`main-sugoi-ahegao\`) changed on top of upstream stash, newest first.
**Generated by \`scripts/changelog\` from commit subjects; don't edit by hand.**

- Upstream's own changes are in its release notes,
  [\`ui/v2.5/src/docs/en/Changelog/\`](ui/v2.5/src/docs/en/Changelog/), which the app shows.
  Never add fork entries there.
- Last upstream commit merged: \`$(git describe --tags --match 'v[0-9]*' --always "$base")\` ($base_date).
- What the fork's features are and how they work: [\`docs/codebase/07-this-fork.md\`](docs/codebase/07-this-fork.md).
  Why things are the way they are: [\`docs/decisions/\`](docs/decisions/).
EOF
	local day="" date rank line
	while IFS=$'\t' read -r date rank line; do
		[[ "$date" == "$day" ]] || { printf '\n## %s\n\n' "$date"; day="$date"; }
		echo "$line"
	done < <(entries | sort -t$'\t' -k1,1r -k2,2n -s)
}

case "${1:-}" in
"")
	render >"$OUT"
	info "Wrote $OUT"
	;;
--check)
	diff -q <(render) "$OUT" >/dev/null 2>&1 || die "$OUT is out of date; run scripts/changelog"
	info "$OUT is up to date"
	;;
*) die "unknown argument '$1' (scripts/changelog [--check])" ;;
esac
